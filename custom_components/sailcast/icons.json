{
  "entity": {
    "binary_sensor": {
      "good_to_sail": {
        "default": "mdi:sail-boat-sink",
        "state": {
          "on": "mdi:sail-boat"
        }
      },
      "marine_warning": {
        "default": "mdi:flag-triangle"
      }
    },
    "calendar": {
      "sailing": {
        "default": "mdi:calendar-month"
      }
    },
    "sensor": {
      "next_high_tide": {
        "default": "mdi:wave-arrow-up"
      },
      "next_low_tide": {
        "default": "mdi:wave-arrow-down"
      },
      "next_window": {
        "default": "mdi:calendar-clock"
      },
      "rating": {
        "default": "mdi:sail-boat",
        "state": {
          "good": "mdi:check-circle",
          "caution": "mdi:alert",
          "not_recommended": "mdi:close-octagon",
          "dangerous": "mdi:alert-octagon"
        }
      },
      "score": {
        "default": "mdi:sail-boat"
      },
      "wave_height": {
        "default": "mdi:waves"
      },
      "wind_direction": {
        "default": "mdi:compass-outline"
      },
      "wind_gust": {
        "default": "mdi:weather-windy"
      }
    }
  },
  "services": {
    "get_forecast": {
      "service": "mdi:sail-boat"
    }
  }
}
